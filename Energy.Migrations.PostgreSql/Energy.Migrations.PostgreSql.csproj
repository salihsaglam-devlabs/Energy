<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
      Dedicated migrations assembly for the PostgreSQL provider. EF Core keeps a
      single ModelSnapshot per migrations assembly, so each database provider must
      live in its OWN assembly. SQL Server migrations stay in Energy.Infrastructure
      (Persistence/Migrations/MsSql); PostgreSQL migrations live here.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Energy.Infrastructure\Energy.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>

</Project>

