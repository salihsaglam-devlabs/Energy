<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
      Dedicated migrations assembly for the SQL Server provider. EF Core keeps a
      single ModelSnapshot per migrations assembly, so each provider lives in its
      own assembly (PostgreSQL migrations live in Energy.Migrations.PostgreSql).
    -->
    <ItemGroup>
        <ProjectReference Include="..\Energy.Infrastructure\Energy.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>

</Project>

