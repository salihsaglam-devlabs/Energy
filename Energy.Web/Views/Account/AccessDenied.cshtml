@using Energy.Localization
@using Microsoft.AspNetCore.Antiforgery
@model Energy.Web.Models.Account.AccessDeniedViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@inject IAntiforgery Antiforgery
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T[LocalizationKeys.Auth.AccessDeniedTitle].Value;
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="energy-auth-form">
    <h1 class="energy-auth-form__title">@T[LocalizationKeys.Auth.AccessDeniedTitle]</h1>
    <p class="energy-auth-form__subtitle">@T[LocalizationKeys.Auth.AccessDeniedDescription]</p>

    <div class="energy-auth-form__subtitle" style="margin-top: 1rem; text-align: left;">
        <strong>@T["Auth.AccessDeniedRequestTitle"]</strong>
        <div>@T["Auth.AccessDeniedRequestedUrl", Model.RequestedPath]</div>
        @if (!string.IsNullOrWhiteSpace(Model.RequestedPermission))
        {
            <div>@T["Auth.AccessDeniedPermissionCode", Model.RequestedPermission]</div>
        }
        <div>@T["Auth.AccessDeniedRequestTarget"]</div>
        <div>@T["Auth.AccessDeniedRequestHowTo"]</div>
    </div>

    <div class="energy-auth-form__actions">
        @if (isAuthenticated)
        {
            <a class="energy-auth-form__link" href="/profile">@T[LocalizationKeys.Auth.MyProfile]</a>
            <span>·</span>
            <a class="energy-auth-form__link" href="/">@T[LocalizationKeys.Auth.BackToDashboard]</a>
            <span>·</span>
            <form method="post" action="/account/logout"
                  style="display:inline; margin:0; padding:0; background:none; border:none;">
                <input type="hidden" name="__RequestVerificationToken" value="@requestToken" />
                <button type="submit" class="energy-auth-form__link"
                        style="background:none; border:none; padding:0; cursor:pointer; color:inherit; text-decoration:underline; font:inherit;">
                    @T[LocalizationKeys.Auth.SignOut]
                </button>
            </form>
        }
        else
        {
            <a class="energy-auth-form__link" href="/account/login">@T[LocalizationKeys.Auth.BackToLogin]</a>
        }
    </div>
</div>
