@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Assets.EquipmentAsset.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Assets.EquipmentAsset.Title"]</h2></div>
    </header>
    <div id="equipment-asset-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/assets/equipment-asset/equipment-asset.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.AssetsEquipmentAsset.init("/assets/equipment-assets", "equipment-asset-grid", "Assets");
        });
    </script>
}
