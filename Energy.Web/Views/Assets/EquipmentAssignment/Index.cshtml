@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Assets.EquipmentAssignment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Assets.EquipmentAssignment.Title"]</h2></div>
    </header>
    <div id="equipment-assignment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/assets/equipment-assignment/equipment-assignment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.AssetsEquipmentAssignment.init("/assets/equipment-assignments", "equipment-assignment-grid", "Assets");
        });
    </script>
}
