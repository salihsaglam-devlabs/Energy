@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Assets.EquipmentAssignment.Title"].Value;
    ViewData["ScreenId"] = "Assets.EquipmentAssignment";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Assets.EquipmentAssignment.Title"]</h2></div>
    </header>
    <div id="equipment-assignment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/assets/equipment-assignment/equipment-assignment.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Assets.EquipmentAssignment.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Organization.Employee.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Assets.EquipmentAsset.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.Warehouse.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.AssetsEquipmentAssignment.init("/assets/equipment-assignments", "equipment-assignment-grid", "Assets");
        });
    </script>
}
