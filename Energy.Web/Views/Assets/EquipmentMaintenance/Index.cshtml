@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Assets.EquipmentMaintenance.Title"].Value;
    ViewData["ScreenId"] = "Assets.EquipmentMaintenance";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Assets.EquipmentMaintenance.Title"]</h2></div>
    </header>
    <div id="equipment-maintenance-grid"></div>
</section>

@section Scripts {
    <script src="~/js/assets/equipment-maintenance/equipment-maintenance.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Assets.EquipmentMaintenance.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Assets.EquipmentAsset.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.AssetsEquipmentMaintenance.init("/assets/equipment-maintenances", "equipment-maintenance-grid", "Assets");
        });
    </script>
}
