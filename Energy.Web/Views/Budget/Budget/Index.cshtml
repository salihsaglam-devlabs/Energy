@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Budget.Budget.Title"].Value;
    ViewData["ScreenId"] = "Budget.Budget";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Budget.Budget.Title"]</h2></div>
    </header>
    <div id="budget-grid"></div>
</section>

@section Scripts {
    <script src="~/js/budget/budget/budget.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Budget.Budget.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.CostCenter.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BudgetBudget.init("/budget/budgets", "budget-grid", "Budget");
        });
    </script>
}
