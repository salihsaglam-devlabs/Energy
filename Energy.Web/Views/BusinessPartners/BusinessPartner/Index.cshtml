@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["BusinessPartners.BusinessPartner.Title"].Value;
    ViewData["ScreenId"] = "BusinessPartners.BusinessPartner";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["BusinessPartners.BusinessPartner.Title"]</h2></div>
    </header>
    <div id="business-partner-grid"></div>
</section>

@section Scripts {
    <script src="~/js/business-partners/business-partner/business-partner.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BusinessPartnersBusinessPartner.init("/business-partners/business-partners", "business-partner-grid", "BusinessPartners");
        });
    </script>
}
