@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["BusinessPartners.BusinessPartnerBankAccount.Title"].Value;
    ViewData["ScreenId"] = "BusinessPartners.BusinessPartnerBankAccount";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["BusinessPartners.BusinessPartnerBankAccount.Title"]</h2></div>
    </header>
    <div id="business-partner-bank-account-grid"></div>
</section>

@section Scripts {
    <script src="~/js/business-partners/business-partner-bank-account/business-partner-bank-account.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["BusinessPartners.BusinessPartner.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BusinessPartnersBusinessPartnerBankAccount.init("/business-partners/business-partner-bank-accounts", "business-partner-bank-account-grid", "BusinessPartners");
        });
    </script>
}
