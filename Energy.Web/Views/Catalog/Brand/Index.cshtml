@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.Brand.Title"].Value;
    ViewData["ScreenId"] = "Catalog.Brand";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.Brand.Title"]</h2></div>
    </header>
    <div id="brand-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/brand/brand.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.Brand.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogBrand.init("/catalog/brands", "brand-grid", "Catalog");
        });
    </script>
}
