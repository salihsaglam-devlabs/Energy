@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Catalog.Material.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Catalog.Material.Title"]</h2></div>
    </header>
    <div id="material-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/catalog/material/material.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterial.init("/catalog/materials", "material-grid", "Catalog");
        });
    </script>
}
