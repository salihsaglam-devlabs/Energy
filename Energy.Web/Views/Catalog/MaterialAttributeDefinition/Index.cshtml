@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.MaterialAttributeDefinition.Title"].Value;
    ViewData["ScreenId"] = "Catalog.MaterialAttributeDefinition";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.MaterialAttributeDefinition.Title"]</h2></div>
    </header>
    <div id="material-attribute-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/material-attribute-definition/material-attribute-definition.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterialAttributeDefinition.init("/catalog/material-attribute-definitions", "material-attribute-definition-grid", "Catalog");
        });
    </script>
}
