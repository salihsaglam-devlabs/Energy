@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.MaterialAttributeOption.Title"].Value;
    ViewData["ScreenId"] = "Catalog.MaterialAttributeOption";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.MaterialAttributeOption.Title"]</h2></div>
    </header>
    <div id="material-attribute-option-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/material-attribute-option/material-attribute-option.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialAttributeOption.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialAttributeDefinition.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterialAttributeOption.init("/catalog/material-attribute-options", "material-attribute-option-grid", "Catalog");
        });
    </script>
}
