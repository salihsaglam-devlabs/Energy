@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.MaterialAttributeValue.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.MaterialAttributeValue.Title"]</h2></div>
    </header>
    <div id="material-attribute-value-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/material-attribute-value/material-attribute-value.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterialAttributeValue.init("/catalog/material-attribute-values", "material-attribute-value-grid", "Catalog");
        });
    </script>
}
