@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.MaterialCategory.Title"].Value;
    ViewData["ScreenId"] = "Catalog.MaterialCategory";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.MaterialCategory.Title"]</h2></div>
    </header>
    <div id="material-category-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/material-category/material-category.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialCategory.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterialCategory.init("/catalog/material-categories", "material-category-grid", "Catalog");
        });
    </script>
}
