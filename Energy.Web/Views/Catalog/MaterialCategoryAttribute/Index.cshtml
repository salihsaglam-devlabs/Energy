@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Catalog.MaterialCategoryAttribute.Title"].Value;
    ViewData["ScreenId"] = "Catalog.MaterialCategoryAttribute";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Catalog.MaterialCategoryAttribute.Title"]</h2></div>
    </header>
    <div id="material-category-attribute-grid"></div>
</section>

@section Scripts {
    <script src="~/js/catalog/material-category-attribute/material-category-attribute.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialCategoryAttribute.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialAttributeDefinition.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.MaterialCategory.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CatalogMaterialCategoryAttribute.init("/catalog/material-category-attributes", "material-category-attribute-grid", "Catalog");
        });
    </script>
}
