@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Contracts.Contract.Title"].Value;
    ViewData["ScreenId"] = "Contracts.Contract";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Contracts.Contract.Title"]</h2></div>
    </header>
    <div id="contract-grid"></div>
</section>

@section Scripts {
    <script src="~/js/contracts/contract/contract.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContract.init("/contracts/contracts", "contract-grid", "Contracts");
        });
    </script>
}
