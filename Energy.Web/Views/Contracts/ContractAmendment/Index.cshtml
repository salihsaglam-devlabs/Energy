@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Contracts.ContractAmendment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Contracts.ContractAmendment.Title"]</h2></div>
    </header>
    <div id="contract-amendment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/contracts/contract-amendment/contract-amendment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContractAmendment.init("/contracts/contract-amendments", "contract-amendment-grid", "Contracts");
        });
    </script>
}
