@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Contracts.ContractLine.Title"].Value;
    ViewData["ScreenId"] = "Contracts.ContractLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Contracts.ContractLine.Title"]</h2></div>
    </header>
    <div id="contract-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/contracts/contract-line/contract-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.ContractLine.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.Contract.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContractLine.init("/contracts/contract-lines", "contract-line-grid", "Contracts");
        });
    </script>
}
