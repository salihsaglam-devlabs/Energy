@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Contracts.ContractParty.Title"].Value;
    ViewData["ScreenId"] = "Contracts.ContractParty";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Contracts.ContractParty.Title"]</h2></div>
    </header>
    <div id="contract-party-grid"></div>
</section>

@section Scripts {
    <script src="~/js/contracts/contract-party/contract-party.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.ContractParty.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["BusinessPartners.BusinessPartner.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.Contract.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContractParty.init("/contracts/contract-parties", "contract-party-grid", "Contracts");
        });
    </script>
}
