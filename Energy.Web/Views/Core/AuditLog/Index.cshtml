@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Core.AuditLog.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Core.AuditLog.Title"]</h2></div>
    </header>
    <div id="audit-log-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/core/audit-log/audit-log.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreAuditLog.init("/core/audit-logs", "audit-log-grid", "Core");
        });
    </script>
}
