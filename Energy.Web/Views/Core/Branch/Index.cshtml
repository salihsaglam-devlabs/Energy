@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.Branch.Title"].Value;
    ViewData["ScreenId"] = "Core.Branch";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.Branch.Title"]</h2></div>
    </header>
    <div id="branch-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/branch/branch.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Company.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreBranch.init("/core/branches", "branch-grid", "Core");
        });
    </script>
}
