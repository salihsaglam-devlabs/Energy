@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.Currency.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.Currency.Title"]</h2></div>
    </header>
    <div id="currency-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/currency/currency.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreCurrency.init("/core/currencies", "currency-grid", "Core");
        });
    </script>
}
