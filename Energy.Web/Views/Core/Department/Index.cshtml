@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Core.Department.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Core.Department.Title"]</h2></div>
    </header>
    <div id="department-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/core/department/department.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreDepartment.init("/core/departments", "department-grid", "Core");
        });
    </script>
}
