@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.Department.Title"].Value;
    ViewData["ScreenId"] = "Core.Department";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.Department.Title"]</h2></div>
    </header>
    <div id="department-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/department/department.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Department.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Company.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreDepartment.init("/core/departments", "department-grid", "Core");
        });
    </script>
}
