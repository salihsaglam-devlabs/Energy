@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.SequenceDefinition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.SequenceDefinition.Title"]</h2></div>
    </header>
    <div id="sequence-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/sequence-definition/sequence-definition.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreSequenceDefinition.init("/core/sequence-definitions", "sequence-definition-grid", "Core");
        });
    </script>
}
