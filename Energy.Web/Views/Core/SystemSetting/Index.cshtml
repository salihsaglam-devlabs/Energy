@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.SystemSetting.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.SystemSetting.Title"]</h2></div>
    </header>
    <div id="system-setting-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/system-setting/system-setting.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreSystemSetting.init("/core/system-settings", "system-setting-grid", "Core");
        });
    </script>
}
