@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.UnitConversion.Title"].Value;
    ViewData["ScreenId"] = "Core.UnitConversion";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.UnitConversion.Title"]</h2></div>
    </header>
    <div id="unit-conversion-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/unit-conversion/unit-conversion.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.UnitConversion.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreUnitConversion.init("/core/unit-conversions", "unit-conversion-grid", "Core");
        });
    </script>
}
