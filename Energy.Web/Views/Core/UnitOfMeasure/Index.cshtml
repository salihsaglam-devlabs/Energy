@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Core.UnitOfMeasure.Title"].Value;
    ViewData["ScreenId"] = "Core.UnitOfMeasure";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Core.UnitOfMeasure.Title"]</h2></div>
    </header>
    <div id="unit-of-measure-grid"></div>
</section>

@section Scripts {
    <script src="~/js/core/unit-of-measure/unit-of-measure.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreUnitOfMeasure.init("/core/units-of-measure", "unit-of-measure-grid", "Core");
        });
    </script>
}
