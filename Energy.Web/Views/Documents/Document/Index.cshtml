@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Documents.Document.Title"].Value;
    ViewData["ScreenId"] = "Documents.Document";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Documents.Document.Title"]</h2></div>
    </header>
    <div id="document-grid"></div>
</section>

@section Scripts {
    <script src="~/js/documents/document/document.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Documents.Document.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Documents.DocumentFolder.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.DocumentsDocument.init("/documents/documents", "document-grid", "Documents");
        });
    </script>
}
