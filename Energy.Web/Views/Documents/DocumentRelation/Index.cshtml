@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Documents.DocumentRelation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Documents.DocumentRelation.Title"]</h2></div>
    </header>
    <div id="document-relation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/documents/document-relation/document-relation.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Documents.Document.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.DocumentsDocumentRelation.init("/documents/document-relations", "document-relation-grid", "Documents");
        });
    </script>
}
