@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["FieldOperations.DailySiteReportEquipment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["FieldOperations.DailySiteReportEquipment.Title"]</h2></div>
    </header>
    <div id="daily-site-report-equipment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/field-operations/daily-site-report-equipment/daily-site-report-equipment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FieldOperationsDailySiteReportEquipment.init("/field-operations/daily-site-report-equipments", "daily-site-report-equipment-grid", "FieldOperations");
        });
    </script>
}
