@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.FieldOperations.DailySiteReportWorker.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.FieldOperations.DailySiteReportWorker.Title"]</h2></div>
    </header>
    <div id="daily-site-report-worker-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/field-operations/daily-site-report-worker/daily-site-report-worker.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FieldOperationsDailySiteReportWorker.init("/field-operations/daily-site-report-workers", "daily-site-report-worker-grid", "FieldOperations");
        });
    </script>
}
