@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["FieldOperations.MeasurementSheet.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["FieldOperations.MeasurementSheet.Title"]</h2></div>
    </header>
    <div id="measurement-sheet-grid"></div>
</section>

@section Scripts {
    <script src="~/js/field-operations/measurement-sheet/measurement-sheet.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.Contract.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FieldOperationsMeasurementSheet.init("/field-operations/measurement-sheets", "measurement-sheet-grid", "FieldOperations");
        });
    </script>
}
