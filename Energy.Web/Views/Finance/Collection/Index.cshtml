@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.Collection.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.Collection.Title"]</h2></div>
    </header>
    <div id="collection-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/collection/collection.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceCollection.init("/finance/collections", "collection-grid", "Finance");
        });
    </script>
}
