@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.CollectionAllocation.Title"].Value;
    ViewData["ScreenId"] = "Finance.CollectionAllocation";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.CollectionAllocation.Title"]</h2></div>
    </header>
    <div id="collection-allocation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/collection-allocation/collection-allocation.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.Collection.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.Receivable.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceCollectionAllocation.init("/finance/collection-allocations", "collection-allocation-grid", "Finance");
        });
    </script>
}
