@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.CostCenter.Title"].Value;
    ViewData["ScreenId"] = "Finance.CostCenter";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.CostCenter.Title"]</h2></div>
    </header>
    <div id="cost-center-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/cost-center/cost-center.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.CostCenter.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceCostCenter.init("/finance/cost-centers", "cost-center-grid", "Finance");
        });
    </script>
}
