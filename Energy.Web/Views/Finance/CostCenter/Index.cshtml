@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.CostCenter.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.CostCenter.Title"]</h2></div>
    </header>
    <div id="cost-center-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/cost-center/cost-center.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceCostCenter.init("/finance/cost-centers", "cost-center-grid", "Finance");
        });
    </script>
}
