@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.FinancialTransaction.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.FinancialTransaction.Title"]</h2></div>
    </header>
    <div id="financial-transaction-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/financial-transaction/financial-transaction.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceFinancialTransaction.init("/finance/financial-transactions", "financial-transaction-grid", "Finance");
        });
    </script>
}
