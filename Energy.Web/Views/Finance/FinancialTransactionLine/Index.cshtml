@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.FinancialTransactionLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.FinancialTransactionLine.Title"]</h2></div>
    </header>
    <div id="financial-transaction-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/financial-transaction-line/financial-transaction-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceFinancialTransactionLine.init("/finance/financial-transaction-lines", "financial-transaction-line-grid", "Finance");
        });
    </script>
}
