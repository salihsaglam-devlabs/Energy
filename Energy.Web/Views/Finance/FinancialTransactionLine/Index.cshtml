@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.FinancialTransactionLine.Title"].Value;
    ViewData["ScreenId"] = "Finance.FinancialTransactionLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.FinancialTransactionLine.Title"]</h2></div>
    </header>
    <div id="financial-transaction-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/financial-transaction-line/financial-transaction-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.FinancialTransactionLine.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.CostCenter.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.FinancialTransaction.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceFinancialTransactionLine.init("/finance/financial-transaction-lines", "financial-transaction-line-grid", "Finance");
        });
    </script>
}
