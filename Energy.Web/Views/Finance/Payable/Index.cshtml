@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.Payable.Title"].Value;
    ViewData["ScreenId"] = "Finance.Payable";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.Payable.Title"]</h2></div>
    </header>
    <div id="payable-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/payable/payable.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinancePayable.init("/finance/payables", "payable-grid", "Finance");
        });
    </script>
}
