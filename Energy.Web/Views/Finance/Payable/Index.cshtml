@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.Payable.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.Payable.Title"]</h2></div>
    </header>
    <div id="payable-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/payable/payable.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinancePayable.init("/finance/payables", "payable-grid", "Finance");
        });
    </script>
}
