@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.Payment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.Payment.Title"]</h2></div>
    </header>
    <div id="payment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/payment/payment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinancePayment.init("/finance/payments", "payment-grid", "Finance");
        });
    </script>
}
