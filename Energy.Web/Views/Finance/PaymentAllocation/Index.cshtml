@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.PaymentAllocation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.PaymentAllocation.Title"]</h2></div>
    </header>
    <div id="payment-allocation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/payment-allocation/payment-allocation.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinancePaymentAllocation.init("/finance/payment-allocations", "payment-allocation-grid", "Finance");
        });
    </script>
}
