@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Finance.Receivable.Title"].Value;
    ViewData["ScreenId"] = "Finance.Receivable";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Finance.Receivable.Title"]</h2></div>
    </header>
    <div id="receivable-grid"></div>
</section>

@section Scripts {
    <script src="~/js/finance/receivable/receivable.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Finance.Receivable.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceReceivable.init("/finance/receivables", "receivable-grid", "Finance");
        });
    </script>
}
