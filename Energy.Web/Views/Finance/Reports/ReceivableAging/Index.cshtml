@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.Reports.ReceivableAging.Title"].Value;
}

<link rel="stylesheet" href="~/css/modules/finance/reports/receivable-aging/receivable-aging.css" asp-append-version="true" />

<section class="energy-screen energy-report">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.Reports.ReceivableAging.Title"]</h2></div>
    </header>
    <div id="receivable-aging-filters" class="energy-report__filters"></div>
    <div id="receivable-aging-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/reports/receivable-aging/receivable-aging.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppReports.FinanceReceivableAging.init("/finance/reports/receivable-aging", "receivable-aging-grid", "receivable-aging-filters", { hasStatus: false });
        });
    </script>
}
