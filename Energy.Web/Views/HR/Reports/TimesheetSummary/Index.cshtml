@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["HR.Reports.TimesheetSummary.Title"].Value;
}

<link rel="stylesheet" href="~/css/h-r/reports/timesheet-summary/timesheet-summary.css" asp-append-version="true" />

<section class="energy-screen energy-report">
    <header class="energy-screen__header">
        <div><h2>@T["HR.Reports.TimesheetSummary.Title"]</h2></div>
    </header>
    <div id="timesheet-summary-filters" class="energy-report__filters"></div>
    <div id="timesheet-summary-grid"></div>
</section>

@section Scripts {
    <script src="~/js/h-r/reports/timesheet-summary/timesheet-summary.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppReports.HRTimesheetSummary.init("/h-r/reports/timesheet-summary", "timesheet-summary-grid", "timesheet-summary-filters", { hasStatus: true });
        });
    </script>
}
