@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["HR.Timesheet.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["HR.Timesheet.Title"]</h2></div>
    </header>
    <div id="timesheet-grid"></div>
</section>

@section Scripts {
    <script src="~/js/h-r/timesheet/timesheet.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.HRTimesheet.init("/h-r/timesheets", "timesheet-grid", "HR");
        });
    </script>
}
