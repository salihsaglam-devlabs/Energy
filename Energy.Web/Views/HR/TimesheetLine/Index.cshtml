@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.HR.TimesheetLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.HR.TimesheetLine.Title"]</h2></div>
    </header>
    <div id="timesheet-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/h-r/timesheet-line/timesheet-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.HRTimesheetLine.init("/h-r/timesheet-lines", "timesheet-line-grid", "HR");
        });
    </script>
}
