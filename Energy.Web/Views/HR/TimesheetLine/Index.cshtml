@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["HR.TimesheetLine.Title"].Value;
    ViewData["ScreenId"] = "HR.TimesheetLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["HR.TimesheetLine.Title"]</h2></div>
    </header>
    <div id="timesheet-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/h-r/timesheet-line/timesheet-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Organization.Employee.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["HR.Timesheet.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Operations.WorkOrder.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.HRTimesheetLine.init("/h-r/timesheet-lines", "timesheet-line-grid", "HR");
        });
    </script>
}
