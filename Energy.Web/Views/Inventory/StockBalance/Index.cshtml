@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockBalance.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockBalance.Title"]</h2></div>
    </header>
    <div id="stock-balance-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-balance/stock-balance.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockBalance.init("/inventory/stock-balances", "stock-balance-grid", "Inventory");
        });
    </script>
}
