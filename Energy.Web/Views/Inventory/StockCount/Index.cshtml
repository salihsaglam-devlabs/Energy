@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockCount.Title"].Value;
    ViewData["ScreenId"] = "Inventory.StockCount";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockCount.Title"]</h2></div>
    </header>
    <div id="stock-count-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-count/stock-count.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.Warehouse.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockCount.init("/inventory/stock-counts", "stock-count-grid", "Inventory");
        });
    </script>
}
