@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockDocument.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockDocument.Title"]</h2></div>
    </header>
    <div id="stock-document-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-document/stock-document.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalRequest.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.StockDocumentType.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.Warehouse.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockDocument.init("/inventory/stock-documents", "stock-document-grid", "Inventory");
        });
    </script>
}
