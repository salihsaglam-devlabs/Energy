@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockDocumentType.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockDocumentType.Title"]</h2></div>
    </header>
    <div id="stock-document-type-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-document-type/stock-document-type.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockDocumentType.init("/inventory/stock-document-types", "stock-document-type-grid", "Inventory");
        });
    </script>
}
