@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.StockDocumentType.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.StockDocumentType.Title"]</h2></div>
    </header>
    <div id="stock-document-type-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/stock-document-type/stock-document-type.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockDocumentType.init("/inventory/stock-document-types", "stock-document-type-grid", "Inventory");
        });
    </script>
}
