@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockLot.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockLot.Title"]</h2></div>
    </header>
    <div id="stock-lot-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-lot/stock-lot.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockLot.init("/inventory/stock-lots", "stock-lot-grid", "Inventory");
        });
    </script>
}
