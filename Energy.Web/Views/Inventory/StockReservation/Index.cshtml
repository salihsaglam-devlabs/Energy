@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.StockReservation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.StockReservation.Title"]</h2></div>
    </header>
    <div id="stock-reservation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/stock-reservation/stock-reservation.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockReservation.init("/inventory/stock-reservations", "stock-reservation-grid", "Inventory");
        });
    </script>
}
