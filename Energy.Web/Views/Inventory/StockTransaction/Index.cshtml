@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.StockTransaction.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.StockTransaction.Title"]</h2></div>
    </header>
    <div id="stock-transaction-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/stock-transaction/stock-transaction.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockTransaction.init("/inventory/stock-transactions", "stock-transaction-grid", "Inventory");
        });
    </script>
}
