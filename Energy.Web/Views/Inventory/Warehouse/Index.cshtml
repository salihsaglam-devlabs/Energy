@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.Warehouse.Title"].Value;
    ViewData["ScreenId"] = "Inventory.Warehouse";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.Warehouse.Title"]</h2></div>
    </header>
    <div id="warehouse-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/warehouse/warehouse.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.Warehouse.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Branch.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Company.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouse.init("/inventory/warehouses", "warehouse-grid", "Inventory");
        });
    </script>
}
