@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.Warehouse.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.Warehouse.Title"]</h2></div>
    </header>
    <div id="warehouse-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/warehouse/warehouse.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouse.init("/inventory/warehouses", "warehouse-grid", "Inventory");
        });
    </script>
}
