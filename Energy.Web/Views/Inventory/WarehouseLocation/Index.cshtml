@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.WarehouseLocation.Title"].Value;
    ViewData["ScreenId"] = "Inventory.WarehouseLocation";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.WarehouseLocation.Title"]</h2></div>
    </header>
    <div id="warehouse-location-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/warehouse-location/warehouse-location.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.WarehouseLocation.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.Warehouse.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouseLocation.init("/inventory/warehouse-locations", "warehouse-location-grid", "Inventory");
        });
    </script>
}
