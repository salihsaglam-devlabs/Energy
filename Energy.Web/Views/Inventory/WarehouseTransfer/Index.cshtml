@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.WarehouseTransfer.Title"].Value;
    ViewData["ScreenId"] = "Inventory.WarehouseTransfer";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.WarehouseTransfer.Title"]</h2></div>
    </header>
    <div id="warehouse-transfer-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/warehouse-transfer/warehouse-transfer.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.WarehouseTransfer.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouseTransfer.init("/inventory/warehouse-transfers", "warehouse-transfer-grid", "Inventory");
        });
    </script>
}
