@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.WarehouseTransfer.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.WarehouseTransfer.Title"]</h2></div>
    </header>
    <div id="warehouse-transfer-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/warehouse-transfer/warehouse-transfer.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouseTransfer.init("/inventory/warehouse-transfers", "warehouse-transfer-grid", "Inventory");
        });
    </script>
}
