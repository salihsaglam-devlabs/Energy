@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Inventory.WarehouseTransferLine.Title"].Value;
    ViewData["ScreenId"] = "Inventory.WarehouseTransferLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Inventory.WarehouseTransferLine.Title"]</h2></div>
    </header>
    <div id="warehouse-transfer-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/inventory/warehouse-transfer-line/warehouse-transfer-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.Material.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Inventory.WarehouseTransfer.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouseTransferLine.init("/inventory/warehouse-transfer-lines", "warehouse-transfer-line-grid", "Inventory");
        });
    </script>
}
