@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T[LocalizationKeys.LogsScreen.DetailTitle].Value;
    var id = ViewBag.LogId;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div>
            <h2>@T[LocalizationKeys.LogsScreen.DetailTitle]</h2>
        </div>
    </header>

    <div id="log-detail"></div>
</section>

@section Scripts {
    <script src="~/js/core/logs.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.Logs.initDetail("@id");
        });
    </script>
}
