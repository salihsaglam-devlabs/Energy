@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Budget.Budget.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Budget.Budget.Title"]</h2></div>
    </header>
    <div id="budget-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/budget/budget/budget.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BudgetBudget.init("/budget/budgets", "budget-grid", "Budget");
        });
    </script>
}
