@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Budget.BudgetLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Budget.BudgetLine.Title"]</h2></div>
    </header>
    <div id="budget-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/budget/budget-line/budget-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BudgetBudgetLine.init("/budget/budget-lines", "budget-line-grid", "Budget");
        });
    </script>
}
