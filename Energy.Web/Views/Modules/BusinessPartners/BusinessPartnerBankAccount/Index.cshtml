@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.BusinessPartners.BusinessPartnerBankAccount.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.BusinessPartners.BusinessPartnerBankAccount.Title"]</h2></div>
    </header>
    <div id="business-partner-bank-account-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/business-partners/business-partner-bank-account/business-partner-bank-account.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.BusinessPartnersBusinessPartnerBankAccount.init("/business-partners/business-partner-bank-accounts", "business-partner-bank-account-grid", "BusinessPartners");
        });
    </script>
}
