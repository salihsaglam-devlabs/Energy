@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Contracts.Contract.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Contracts.Contract.Title"]</h2></div>
    </header>
    <div id="contract-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/contracts/contract/contract.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContract.init("/contracts/contracts", "contract-grid", "Contracts");
        });
    </script>
}
