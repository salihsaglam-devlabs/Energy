@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Contracts.ContractParty.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Contracts.ContractParty.Title"]</h2></div>
    </header>
    <div id="contract-party-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/contracts/contract-party/contract-party.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ContractsContractParty.init("/contracts/contract-parties", "contract-party-grid", "Contracts");
        });
    </script>
}
