@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Core.Company.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Core.Company.Title"]</h2></div>
    </header>
    <div id="company-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/core/company/company.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreCompany.init("/core/companies", "company-grid", "Core");
        });
    </script>
}
