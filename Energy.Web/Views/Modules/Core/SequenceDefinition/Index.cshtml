@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Core.SequenceDefinition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Core.SequenceDefinition.Title"]</h2></div>
    </header>
    <div id="sequence-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/core/sequence-definition/sequence-definition.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.CoreSequenceDefinition.init("/core/sequence-definitions", "sequence-definition-grid", "Core");
        });
    </script>
}
