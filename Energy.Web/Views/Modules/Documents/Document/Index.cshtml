@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Documents.Document.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Documents.Document.Title"]</h2></div>
    </header>
    <div id="document-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/documents/document/document.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.DocumentsDocument.init("/documents/documents", "document-grid", "Documents");
        });
    </script>
}
