@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Finance.CollectionAllocation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Finance.CollectionAllocation.Title"]</h2></div>
    </header>
    <div id="collection-allocation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/finance/collection-allocation/collection-allocation.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.FinanceCollectionAllocation.init("/finance/collection-allocations", "collection-allocation-grid", "Finance");
        });
    </script>
}
