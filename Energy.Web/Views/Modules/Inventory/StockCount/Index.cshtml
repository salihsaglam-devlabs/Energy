@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.StockCount.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.StockCount.Title"]</h2></div>
    </header>
    <div id="stock-count-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/stock-count/stock-count.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockCount.init("/inventory/stock-counts", "stock-count-grid", "Inventory");
        });
    </script>
}
