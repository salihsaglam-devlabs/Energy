@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.StockIssueAllocation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.StockIssueAllocation.Title"]</h2></div>
    </header>
    <div id="stock-issue-allocation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/stock-issue-allocation/stock-issue-allocation.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryStockIssueAllocation.init("/inventory/stock-issue-allocations", "stock-issue-allocation-grid", "Inventory");
        });
    </script>
}
