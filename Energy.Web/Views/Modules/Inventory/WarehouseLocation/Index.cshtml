@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Inventory.WarehouseLocation.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Inventory.WarehouseLocation.Title"]</h2></div>
    </header>
    <div id="warehouse-location-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/inventory/warehouse-location/warehouse-location.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.InventoryWarehouseLocation.init("/inventory/warehouse-locations", "warehouse-location-grid", "Inventory");
        });
    </script>
}
