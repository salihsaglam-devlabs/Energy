@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Procurement.PurchaseReceiptLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Procurement.PurchaseReceiptLine.Title"]</h2></div>
    </header>
    <div id="purchase-receipt-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/procurement/purchase-receipt-line/purchase-receipt-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementPurchaseReceiptLine.init("/procurement/purchase-receipt-lines", "purchase-receipt-line-grid", "Procurement");
        });
    </script>
}
