@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.ProgressPayments.ProgressPayment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.ProgressPayments.ProgressPayment.Title"]</h2></div>
    </header>
    <div id="progress-payment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/progress-payments/progress-payment/progress-payment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProgressPaymentsProgressPayment.init("/progress-payments/progress-payments", "progress-payment-grid", "ProgressPayments");
        });
    </script>
}
