@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Projects.ProjectMember.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Projects.ProjectMember.Title"]</h2></div>
    </header>
    <div id="project-member-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/projects/project-member/project-member.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProjectsProjectMember.init("/projects/project-members", "project-member-grid", "Projects");
        });
    </script>
}
