@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Requests.RequestLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Requests.RequestLine.Title"]</h2></div>
    </header>
    <div id="request-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/requests/request-line/request-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.RequestsRequestLine.init("/requests/request-lines", "request-line-grid", "Requests");
        });
    </script>
}
