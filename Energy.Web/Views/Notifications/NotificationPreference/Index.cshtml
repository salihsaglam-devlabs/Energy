@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Notifications.NotificationPreference.Title"].Value;
    ViewData["ScreenId"] = "Notifications.NotificationPreference";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Notifications.NotificationPreference.Title"]</h2></div>
    </header>
    <div id="notification-preference-grid"></div>
</section>

@section Scripts {
    <script src="~/js/notifications/notification-preference/notification-preference.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Notifications.NotificationPreference.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.NotificationsNotificationPreference.init("/notifications/notification-preferences", "notification-preference-grid", "Notifications");
        });
    </script>
}
