@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Notifications.NotificationRecipient.Title"].Value;
    ViewData["ScreenId"] = "Notifications.NotificationRecipient";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Notifications.NotificationRecipient.Title"]</h2></div>
    </header>
    <div id="notification-recipient-grid"></div>
</section>

@section Scripts {
    <script src="~/js/notifications/notification-recipient/notification-recipient.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Notifications.Notification.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.NotificationsNotificationRecipient.init("/notifications/notification-recipients", "notification-recipient-grid", "Notifications");
        });
    </script>
}
