@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Operations.WorkOrderChecklist.Title"].Value;
    ViewData["ScreenId"] = "Operations.WorkOrderChecklist";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Operations.WorkOrderChecklist.Title"]</h2></div>
    </header>
    <div id="work-order-checklist-grid"></div>
</section>

@section Scripts {
    <script src="~/js/operations/work-order-checklist/work-order-checklist.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Operations.WorkOrderChecklist.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Operations.WorkOrder.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OperationsWorkOrderChecklist.init("/operations/work-order-checklists", "work-order-checklist-grid", "Operations");
        });
    </script>
}
