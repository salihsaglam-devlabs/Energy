@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Operations.WorkOrderChecklistItem.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Operations.WorkOrderChecklistItem.Title"]</h2></div>
    </header>
    <div id="work-order-checklist-item-grid"></div>
</section>

@section Scripts {
    <script src="~/js/operations/work-order-checklist-item/work-order-checklist-item.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Operations.WorkOrderChecklist.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OperationsWorkOrderChecklistItem.init("/operations/work-order-checklist-items", "work-order-checklist-item-grid", "Operations");
        });
    </script>
}
