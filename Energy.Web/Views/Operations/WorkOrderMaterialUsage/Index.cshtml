@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Operations.WorkOrderMaterialUsage.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Operations.WorkOrderMaterialUsage.Title"]</h2></div>
    </header>
    <div id="work-order-material-usage-grid"></div>
</section>

@section Scripts {
    <script src="~/js/operations/work-order-material-usage/work-order-material-usage.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OperationsWorkOrderMaterialUsage.init("/operations/work-order-material-usages", "work-order-material-usage-grid", "Operations");
        });
    </script>
}
