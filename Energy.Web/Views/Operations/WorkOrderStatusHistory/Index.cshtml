@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Operations.WorkOrderStatusHistory.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Operations.WorkOrderStatusHistory.Title"]</h2></div>
    </header>
    <div id="work-order-status-history-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/operations/work-order-status-history/work-order-status-history.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OperationsWorkOrderStatusHistory.init("/operations/work-order-status-histories", "work-order-status-history-grid", "Operations");
        });
    </script>
}
