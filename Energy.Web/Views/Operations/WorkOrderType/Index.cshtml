@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Operations.WorkOrderType.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Operations.WorkOrderType.Title"]</h2></div>
    </header>
    <div id="work-order-type-grid"></div>
</section>

@section Scripts {
    <script src="~/js/operations/work-order-type/work-order-type.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OperationsWorkOrderType.init("/operations/work-order-types", "work-order-type-grid", "Operations");
        });
    </script>
}
