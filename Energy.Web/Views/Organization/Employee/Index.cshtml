@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Organization.Employee.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Organization.Employee.Title"]</h2></div>
    </header>
    <div id="employee-grid"></div>
</section>

@section Scripts {
    <script src="~/js/organization/employee/employee.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Branch.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Company.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Department.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Organization.EmployeePosition.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationEmployee.init("/organization/employees", "employee-grid", "Organization");
        });
    </script>
}
