@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Organization.EmployeePosition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Organization.EmployeePosition.Title"]</h2></div>
    </header>
    <div id="employee-position-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/organization/employee-position/employee-position.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationEmployeePosition.init("/organization/employee-positions", "employee-position-grid", "Organization");
        });
    </script>
}
