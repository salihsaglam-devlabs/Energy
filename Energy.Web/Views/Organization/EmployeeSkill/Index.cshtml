@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Organization.EmployeeSkill.Title"].Value;
    ViewData["ScreenId"] = "Organization.EmployeeSkill";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Organization.EmployeeSkill.Title"]</h2></div>
    </header>
    <div id="employee-skill-grid"></div>
</section>

@section Scripts {
    <script src="~/js/organization/employee-skill/employee-skill.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationEmployeeSkill.init("/organization/employee-skills", "employee-skill-grid", "Organization");
        });
    </script>
}
