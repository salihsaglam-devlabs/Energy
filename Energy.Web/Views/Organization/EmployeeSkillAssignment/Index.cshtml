@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Organization.EmployeeSkillAssignment.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Organization.EmployeeSkillAssignment.Title"]</h2></div>
    </header>
    <div id="employee-skill-assignment-grid"></div>
</section>

@section Scripts {
    <script src="~/js/organization/employee-skill-assignment/employee-skill-assignment.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationEmployeeSkillAssignment.init("/organization/employee-skill-assignments", "employee-skill-assignment-grid", "Organization");
        });
    </script>
}
