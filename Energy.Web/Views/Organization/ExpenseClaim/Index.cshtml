@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Organization.ExpenseClaim.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Organization.ExpenseClaim.Title"]</h2></div>
    </header>
    <div id="expense-claim-grid"></div>
</section>

@section Scripts {
    <script src="~/js/organization/expense-claim/expense-claim.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationExpenseClaim.init("/organization/expense-claims", "expense-claim-grid", "Organization");
        });
    </script>
}
