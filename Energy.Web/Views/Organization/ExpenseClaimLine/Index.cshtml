@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Organization.ExpenseClaimLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Organization.ExpenseClaimLine.Title"]</h2></div>
    </header>
    <div id="expense-claim-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/organization/expense-claim-line/expense-claim-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.OrganizationExpenseClaimLine.init("/organization/expense-claim-lines", "expense-claim-line-grid", "Organization");
        });
    </script>
}
