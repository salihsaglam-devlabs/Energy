@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Procurement.PurchaseReceiptLine.Title"].Value;
    ViewData["ScreenId"] = "Procurement.PurchaseReceiptLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Procurement.PurchaseReceiptLine.Title"]</h2></div>
    </header>
    <div id="purchase-receipt-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/procurement/purchase-receipt-line/purchase-receipt-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.PurchaseReceiptLine.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.Material.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.PurchaseOrderLine.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.PurchaseReceipt.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementPurchaseReceiptLine.init("/procurement/purchase-receipt-lines", "purchase-receipt-line-grid", "Procurement");
        });
    </script>
}
