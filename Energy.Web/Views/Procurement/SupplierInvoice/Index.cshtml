@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Procurement.SupplierInvoice.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Procurement.SupplierInvoice.Title"]</h2></div>
    </header>
    <div id="supplier-invoice-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/procurement/supplier-invoice/supplier-invoice.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementSupplierInvoice.init("/procurement/supplier-invoices", "supplier-invoice-grid", "Procurement");
        });
    </script>
}
