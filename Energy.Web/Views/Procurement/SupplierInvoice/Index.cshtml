@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Procurement.SupplierInvoice.Title"].Value;
    ViewData["ScreenId"] = "Procurement.SupplierInvoice";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Procurement.SupplierInvoice.Title"]</h2></div>
    </header>
    <div id="supplier-invoice-grid"></div>
</section>

@section Scripts {
    <script src="~/js/procurement/supplier-invoice/supplier-invoice.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.PurchaseOrder.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.PurchaseReceipt.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementSupplierInvoice.init("/procurement/supplier-invoices", "supplier-invoice-grid", "Procurement");
        });
    </script>
}
