@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Procurement.SupplierQuote.Title"].Value;
    ViewData["ScreenId"] = "Procurement.SupplierQuote";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Procurement.SupplierQuote.Title"]</h2></div>
    </header>
    <div id="supplier-quote-grid"></div>
</section>

@section Scripts {
    <script src="~/js/procurement/supplier-quote/supplier-quote.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.SupplierQuote.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.Currency.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementSupplierQuote.init("/procurement/supplier-quotes", "supplier-quote-grid", "Procurement");
        });
    </script>
}
