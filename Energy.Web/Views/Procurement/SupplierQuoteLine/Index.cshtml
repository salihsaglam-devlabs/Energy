@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Procurement.SupplierQuoteLine.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Procurement.SupplierQuoteLine.Title"]</h2></div>
    </header>
    <div id="supplier-quote-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/procurement/supplier-quote-line/supplier-quote-line.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementSupplierQuoteLine.init("/procurement/supplier-quote-lines", "supplier-quote-line-grid", "Procurement");
        });
    </script>
}
