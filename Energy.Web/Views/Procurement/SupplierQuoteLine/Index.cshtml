@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Procurement.SupplierQuoteLine.Title"].Value;
    ViewData["ScreenId"] = "Procurement.SupplierQuoteLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Procurement.SupplierQuoteLine.Title"]</h2></div>
    </header>
    <div id="supplier-quote-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/procurement/supplier-quote-line/supplier-quote-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.Material.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Requests.RequestLine.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Procurement.SupplierQuote.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProcurementSupplierQuoteLine.init("/procurement/supplier-quote-lines", "supplier-quote-line-grid", "Procurement");
        });
    </script>
}
