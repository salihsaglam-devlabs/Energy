@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["ProgressPayments.ProgressPaymentLine.Title"].Value;
    ViewData["ScreenId"] = "ProgressPayments.ProgressPaymentLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["ProgressPayments.ProgressPaymentLine.Title"]</h2></div>
    </header>
    <div id="progress-payment-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/progress-payments/progress-payment-line/progress-payment-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["ProgressPayments.ProgressPaymentLine.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Contracts.ContractLine.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["FieldOperations.MeasurementSheetLine.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["ProgressPayments.ProgressPayment.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProgressPaymentsProgressPaymentLine.init("/progress-payments/progress-payment-lines", "progress-payment-line-grid", "ProgressPayments");
        });
    </script>
}
