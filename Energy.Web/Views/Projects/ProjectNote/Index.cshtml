@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Projects.ProjectNote.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Projects.ProjectNote.Title"]</h2></div>
    </header>
    <div id="project-note-grid"></div>
</section>

@section Scripts {
    <script src="~/js/projects/project-note/project-note.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProjectsProjectNote.init("/projects/project-notes", "project-note-grid", "Projects");
        });
    </script>
}
