@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Projects.ProjectNote.Title"].Value;
    ViewData["ScreenId"] = "Projects.ProjectNote";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Projects.ProjectNote.Title"]</h2></div>
    </header>
    <div id="project-note-grid"></div>
</section>

@section Scripts {
    <script src="~/js/projects/project-note/project-note.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProjectsProjectNote.init("/projects/project-notes", "project-note-grid", "Projects");
        });
    </script>
}
