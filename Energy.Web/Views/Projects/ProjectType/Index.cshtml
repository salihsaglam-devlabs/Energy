@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Projects.ProjectType.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Projects.ProjectType.Title"]</h2></div>
    </header>
    <div id="project-type-grid"></div>
</section>

@section Scripts {
    <script src="~/js/projects/project-type/project-type.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ProjectsProjectType.init("/projects/project-types", "project-type-grid", "Projects");
        });
    </script>
}
