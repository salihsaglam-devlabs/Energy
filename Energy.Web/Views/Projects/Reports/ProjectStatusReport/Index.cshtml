@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Projects.Reports.ProjectStatusReport.Title"].Value;
}

<link rel="stylesheet" href="~/css/projects/reports/project-status-report/project-status-report.css" asp-append-version="true" />

<section class="energy-screen energy-report">
    <header class="energy-screen__header">
        <div><h2>@T["Projects.Reports.ProjectStatusReport.Title"]</h2></div>
    </header>
    <div id="project-status-report-filters" class="energy-report__filters"></div>
    <div id="project-status-report-grid"></div>
</section>

@section Scripts {
    <script src="~/js/projects/reports/project-status-report/project-status-report.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroReport"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppReports.ProjectsProjectStatusReport.init("/projects/reports/project-status-report", "project-status-report-grid", "project-status-report-filters", { hasStatus: false });
        });
    </script>
}
