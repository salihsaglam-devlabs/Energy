@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Reporting.DashboardWidget.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Reporting.DashboardWidget.Title"]</h2></div>
    </header>
    <div id="dashboard-widget-grid"></div>
</section>

@section Scripts {
    <script src="~/js/reporting/dashboard-widget/dashboard-widget.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ReportingDashboardWidget.init("/reporting/dashboard-widgets", "dashboard-widget-grid", "Reporting");
        });
    </script>
}
