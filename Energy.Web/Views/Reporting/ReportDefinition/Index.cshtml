@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Reporting.ReportDefinition.Title"].Value;
    ViewData["ScreenId"] = "Reporting.ReportDefinition";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Reporting.ReportDefinition.Title"]</h2></div>
    </header>
    <div id="report-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/reporting/report-definition/report-definition.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Reporting.ReportDefinition.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.ReportingReportDefinition.init("/reporting/report-definitions", "report-definition-grid", "Reporting");
        });
    </script>
}
