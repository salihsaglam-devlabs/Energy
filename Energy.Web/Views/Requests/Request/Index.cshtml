@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Requests.Request.Title"].Value;
    ViewData["ScreenId"] = "Requests.Request";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Requests.Request.Title"]</h2></div>
    </header>
    <div id="request-grid"></div>
</section>

@section Scripts {
    <script src="~/js/requests/request/request.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Requests.Request.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalRequest.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Projects.Project.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Requests.RequestType.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.RequestsRequest.init("/requests/requests", "request-grid", "Requests");
        });
    </script>
}
