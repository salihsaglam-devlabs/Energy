@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Requests.Request.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Requests.Request.Title"]</h2></div>
    </header>
    <div id="request-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/requests/request/request.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.RequestsRequest.init("/requests/requests", "request-grid", "Requests");
        });
    </script>
}
