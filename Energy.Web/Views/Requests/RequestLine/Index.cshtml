@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Requests.RequestLine.Title"].Value;
    ViewData["ScreenId"] = "Requests.RequestLine";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Requests.RequestLine.Title"]</h2></div>
    </header>
    <div id="request-line-grid"></div>
</section>

@section Scripts {
    <script src="~/js/requests/request-line/request-line.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Catalog.Material.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Requests.Request.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Core.UnitOfMeasure.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.RequestsRequestLine.init("/requests/request-lines", "request-line-grid", "Requests");
        });
    </script>
}
