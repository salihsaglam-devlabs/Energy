@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Requests.RequestType.Title"].Value;
    ViewData["ScreenId"] = "Requests.RequestType";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Requests.RequestType.Title"]</h2></div>
    </header>
    <div id="request-type-grid"></div>
</section>

@section Scripts {
    <script src="~/js/requests/request-type/request-type.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Requests.RequestType.Help.Intro"].Value))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.RequestsRequestType.init("/requests/request-types", "request-type-grid", "Requests");
        });
    </script>
}
