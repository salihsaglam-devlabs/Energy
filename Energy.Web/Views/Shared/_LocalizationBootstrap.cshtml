@using Energy.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> SL
@{
    string Tx(string key) => SL.GetText(key);
    var captions = FieldCaptions.ForCulture(System.Globalization.CultureInfo.CurrentUICulture);
    var captionsJson = System.Text.Json.JsonSerializer.Serialize(captions);
    var fieldTypesJson = System.Text.Json.JsonSerializer.Serialize(FieldTypes.Map);
    var fieldLookupsJson = System.Text.Json.JsonSerializer.Serialize(FieldLookups.Map);
    var enumCaptionsJson = System.Text.Json.JsonSerializer.Serialize(EnumCaptions.ForCulture(System.Globalization.CultureInfo.CurrentUICulture));

    // Ekran bazlı (per-screen) yerelleştirme: aktif ekranın tüm metinleri.
    var screenId = ViewData["ScreenId"] as string;
    string screenJson = "null";
    if (ScreenLocalization.IsKnown(screenId))
    {
        var screenDict = ScreenLocalization.Build(screenId!, SL);
        screenJson = System.Text.Json.JsonSerializer.Serialize(screenDict);
    }

    // Bespoke IAM/Core ekranları (Users, Roles, Menus, ...) generic grid kaydında
    // olmadığından kendi grid/bildirim/ödünç metinlerini kendi "{Prefix}.*"
    // bölümlerinden alır. Aşağıdaki harita her ekranın JS namespace'ine bu
    // ekran-özel metinleri ekler; böylece hiçbir özel ekran paylaşımlı Grid.* /
    // Notifications.* / başka ekranın anahtarını kullanmaz.
    Dictionary<string, string> GridBlock(string p) => new()
    {
        ["add"] = Tx(p + ".GridAdd"), ["edit"] = Tx(p + ".GridEdit"), ["delete"] = Tx(p + ".GridDelete"),
        ["save"] = Tx(p + ".GridSave"), ["cancel"] = Tx(p + ".GridCancel"), ["refresh"] = Tx(p + ".GridRefresh"),
        ["search"] = Tx(p + ".GridSearch"), ["loading"] = Tx(p + ".GridLoading"), ["noData"] = Tx(p + ".GridNoData"),
        ["actions"] = Tx(p + ".GridActions"), ["confirmDelete"] = Tx(p + ".GridConfirmDelete"),
    };
    Dictionary<string, string> NotifBlock(string p) => new()
    {
        ["saved"] = Tx(p + ".NotifSaved"), ["deleted"] = Tx(p + ".NotifDeleted"),
        ["failed"] = Tx(p + ".NotifFailed"), ["networkError"] = Tx(p + ".NotifNetworkError"),
    };
    object ScreenExtra(string p, bool grid, bool notif, Dictionary<string, string>? extra = null)
    {
        var d = new Dictionary<string, object?>();
        if (grid) { d["grid"] = GridBlock(p); }
        if (notif) { d["notifications"] = NotifBlock(p); }
        if (extra != null) { foreach (var kv in extra) { d[kv.Key] = Tx(p + "." + kv.Value); } }
        return d;
    }
    var screenExtras = new Dictionary<string, object?>
    {
        ["users"] = ScreenExtra("UsersScreen", true, true, new() { ["fieldRequired"] = "FieldRequired" }),
        ["roles"] = ScreenExtra("RolesScreen", true, true, new() { ["permissionLabel"] = "PermissionLabel" }),
        ["menus"] = ScreenExtra("MenusScreen", true, true, new()
        {
            ["managePermissions"] = "ManagePermissions",
            ["permissionsTitle"] = "PermissionsTitle",
            ["permissionLabel"] = "PermissionLabel",
        }),
        ["permissions"] = ScreenExtra("PermissionsScreen", true, true),
        ["userAccess"] = ScreenExtra("UserAccessScreen", true, true, new()
        {
            ["firstName"] = "FirstName", ["lastName"] = "LastName",
            ["userName"] = "UserName", ["isActive"] = "IsActive",
        }),
        ["apiEndpoints"] = ScreenExtra("ApiEndpointsScreen", true, true),
        ["logs"] = ScreenExtra("LogsScreen", true, true),
        ["settings"] = ScreenExtra("SettingsScreen", false, true),
        ["localization"] = ScreenExtra("LocalizationScreen", true, true),
    };
    var screenExtrasJson = System.Text.Json.JsonSerializer.Serialize(screenExtras);
}
