    // ---- Ekran bazlı yerelleştirme (per-screen) ----
    // Aktif ekranın TÜM metinleri window.AppScreenL10n üzerinde toplanır. Ekran
    // JS dosyaları (LG()/LN()/LR()/LP()) doğrudan bu nesneden okur; ortak
    // window.AppL10n sözlüklerine bağımlılık yoktur. (Not: window.AppScreen adı
    // görsel rozet bileşeni screen.js tarafından kullanıldığından çakışmayı
    // önlemek için ayrı bir ad kullanılır.)
    //
    // Ayrıca yalnızca ekrandan-bağımsız ortak yardımcıların (grid-l10n.js kolon
    // başlıkları, screen.js rozetleri, info-panel.js yardım metni) ekran-özel
    // metinleri kullanması için ilgili paylaşımlı sözlükler bu ekranın
    // değerleriyle ezilir. Her sayfa tek bir ekran olduğundan bu güvenlidir.
    window.AppScreenL10n = @Html.Raw(screenJson);
    if (window.AppScreenL10n) {
        var s = window.AppScreenL10n;
        // Kolon başlıkları: ekranın kendi Columns sözlüğü globalin üstüne yazılır.
        if (s.columns) {
            window.AppL10n.captions = window.AppL10n.captions || {};
            for (var cf in s.columns) {
                if (Object.prototype.hasOwnProperty.call(s.columns, cf) && s.columns[cf]) {
                    window.AppL10n.captions[cf] = s.columns[cf];
                }
            }
        }
        // Grid metinleri (Ara..., Kayıt yok, Yükleniyor...) ekran-özel.
        if (s.grid) {
            window.AppL10n.grid = window.AppL10n.grid || {};
            if (s.grid.search) { window.AppL10n.grid.search = s.grid.search; }
            if (s.grid.noData) { window.AppL10n.grid.noData = s.grid.noData; }
            if (s.grid.loading) { window.AppL10n.grid.loading = s.grid.loading; }
        }
        // Aksiyon butonları (Yeni, Düzenle, Sil, Kaydet, İptal, Yenile) ekran-özel.
        if (s.actions) {
            window.AppL10n.grid = window.AppL10n.grid || {};
            if (s.actions.new) { window.AppL10n.grid.add = s.actions.new; }
            if (s.actions.edit) { window.AppL10n.grid.edit = s.actions.edit; }
            if (s.actions.delete) { window.AppL10n.grid.delete = s.actions.delete; }
            if (s.actions.save) { window.AppL10n.grid.save = s.actions.save; }
            if (s.actions.cancel) { window.AppL10n.grid.cancel = s.actions.cancel; }
            if (s.actions.refresh) { window.AppL10n.grid.refresh = s.actions.refresh; }
        }
        // Bildirim metinleri (Kaydedildi, Güncellendi, Silindi) ekran-özel.
        if (s.notifications) {
            window.AppL10n.notifications = window.AppL10n.notifications || {};
            if (s.notifications.saved) { window.AppL10n.notifications.saved = s.notifications.saved; }
            if (s.notifications.updated) { window.AppL10n.notifications.saved = window.AppL10n.notifications.saved || s.notifications.updated; }
            if (s.notifications.deleted) { window.AppL10n.notifications.deleted = s.notifications.deleted; }
        }
        // Onay metni (silme onayı) ekran-özel.
        if (s.confirm && s.confirm.delete) {
            window.AppL10n.grid = window.AppL10n.grid || {};
            window.AppL10n.grid.confirmDelete = s.confirm.delete;
        }
        // Süreç ekranı metinleri (Çalıştır, hata, sonuç etiketleri) ekran-özel.
        if (s.process) {
            window.AppL10n.processes = window.AppL10n.processes || {};
            if (s.process.genericError) { window.AppL10n.processes.genericError = s.process.genericError; }
            if (s.process.genericSuccess) { window.AppL10n.processes.genericSuccess = s.process.genericSuccess; }
            if (s.process.submit) { window.AppL10n.processes.submit = s.process.submit; }
            if (s.process.reset) { window.AppL10n.processes.reset = s.process.reset; }
            if (s.process.resultTotal) { window.AppL10n.processes.resultTotal = s.process.resultTotal; }
            if (s.process.resultTotalCost) { window.AppL10n.processes.resultTotalCost = s.process.resultTotalCost; }
            if (s.process.resultTransaction) { window.AppL10n.processes.resultTransaction = s.process.resultTransaction; }
            if (s.process.resultLines) { window.AppL10n.processes.resultLines = s.process.resultLines; }
            if (s.process.resultAllocations) { window.AppL10n.processes.resultAllocations = s.process.resultAllocations; }
        }
        // Rapor ekranı metinleri (tarih filtreleri, durum, dışa aktar) ekran-özel.
        if (s.report) {
            window.AppL10n.reports = window.AppL10n.reports || {};
            if (s.report.startDate) { window.AppL10n.reports.startDate = s.report.startDate; }
            if (s.report.endDate) { window.AppL10n.reports.endDate = s.report.endDate; }
            if (s.report.status) { window.AppL10n.reports.status = s.report.status; }
            if (s.report.allStatuses) { window.AppL10n.reports.allStatuses = s.report.allStatuses; }
            if (s.report.export) { window.AppL10n.reports.export = s.report.export; }
            if (s.report.filters) { window.AppL10n.reports.filters = s.report.filters; }
            if (s.report.refresh) { window.AppL10n.reports.refresh = s.report.refresh; }
        }
        // Yardım/açıklama paneli ekran-özel — info panel bu ekranın metinlerini gösterir.
        if (s.help) {
            window.AppL10n.help = window.AppL10n.help || {};
            for (var hk in s.help) {
                if (Object.prototype.hasOwnProperty.call(s.help, hk) && s.help[hk]) {
                    window.AppL10n.help[hk] = s.help[hk];
                }
            }
        }
        // Modül aksiyon butonları ekran-özel.
        if (s.moduleActions) {
            window.AppL10n.moduleActions = window.AppL10n.moduleActions || {};
            for (var mk in s.moduleActions) {
                if (Object.prototype.hasOwnProperty.call(s.moduleActions, mk) && s.moduleActions[mk]) {
                    window.AppL10n.moduleActions[mk] = s.moduleActions[mk];
                }
            }
        }
        // Diyalog/uyarı butonları ekran-özel.
        if (s.alerts) {
            window.AppL10n.alerts = window.AppL10n.alerts || {};
            for (var ak in s.alerts) {
                if (Object.prototype.hasOwnProperty.call(s.alerts, ak) && s.alerts[ak]) {
                    window.AppL10n.alerts[ak] = s.alerts[ak];
                }
            }
        }
        // Genel diyalog metinleri ekran-özel.
        if (s.common) {
            window.AppL10n.common = window.AppL10n.common || {};
            for (var ck in s.common) {
                if (Object.prototype.hasOwnProperty.call(s.common, ck) && s.common[ck]) {
                    window.AppL10n.common[ck] = s.common[ck];
                }
            }
        }
        // Ekran tür rozeti ekran-özel.
        if (s.screenChrome) {
            window.AppL10n.screen = window.AppL10n.screen || {};
            for (var sk in s.screenChrome) {
                if (Object.prototype.hasOwnProperty.call(s.screenChrome, sk) && s.screenChrome[sk]) {
                    window.AppL10n.screen[sk] = s.screenChrome[sk];
                }
            }
        }
    }

    // ---- Bespoke ekran metinleri (Users/Roles/Menus/...) ----
    // Her özel ekranın grid/bildirim/ödünç metinleri KENDİ namespace'ine eklenir;
    // bu ekranlar artık paylaşımlı window.AppL10n.grid/notifications kullanmaz.
    var __screenExtras = @Html.Raw(screenExtrasJson);
    for (var __ns in __screenExtras) {
        if (!Object.prototype.hasOwnProperty.call(__screenExtras, __ns)) { continue; }
        window.AppL10n[__ns] = window.AppL10n[__ns] || {};
        var __src = __screenExtras[__ns];
        for (var __k in __src) {
            if (Object.prototype.hasOwnProperty.call(__src, __k)) {
                window.AppL10n[__ns][__k] = __src[__k];
            }
        }
    }
