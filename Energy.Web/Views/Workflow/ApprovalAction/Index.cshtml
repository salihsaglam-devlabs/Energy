@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalAction.Title"].Value;
    ViewData["ScreenId"] = "Workflow.ApprovalAction";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalAction.Title"]</h2></div>
    </header>
    <div id="approval-action-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-action/approval-action.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalAction.Help.Intro"].Value)),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalRequest.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalRequestStep.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalAction.init("/workflow/approval-actions", "approval-action-grid", "Workflow");
        });
    </script>
}
