@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalCondition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalCondition.Title"]</h2></div>
    </header>
    <div id="approval-condition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-condition/approval-condition.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalCondition.init("/workflow/approval-conditions", "approval-condition-grid", "Workflow");
        });
    </script>
}
