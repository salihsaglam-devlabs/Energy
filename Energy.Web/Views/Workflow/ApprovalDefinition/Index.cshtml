@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalDefinition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalDefinition.Title"]</h2></div>
    </header>
    <div id="approval-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-definition/approval-definition.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalDefinition.init("/workflow/approval-definitions", "approval-definition-grid", "Workflow");
        });
    </script>
}
