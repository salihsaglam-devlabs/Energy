@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Modules.Workflow.ApprovalDefinition.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Modules.Workflow.ApprovalDefinition.Title"]</h2></div>
    </header>
    <div id="approval-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/modules/workflow/approval-definition/approval-definition.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalDefinition.init("/workflow/approval-definitions", "approval-definition-grid", "Workflow");
        });
    </script>
}
