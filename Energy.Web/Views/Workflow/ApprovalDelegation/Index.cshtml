@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalDelegation.Title"].Value;
    ViewData["ScreenId"] = "Workflow.ApprovalDelegation";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalDelegation.Title"]</h2></div>
    </header>
    <div id="approval-delegation-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-delegation/approval-delegation.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"])))
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalDelegation.init("/workflow/approval-delegations", "approval-delegation-grid", "Workflow");
        });
    </script>
}
