@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalRequest.Title"].Value;
    ViewData["ScreenId"] = "Workflow.ApprovalRequest";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalRequest.Title"]</h2></div>
    </header>
    <div id="approval-request-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-request/approval-request.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalDefinitionVersion.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalRequest.init("/workflow/approval-requests", "approval-request-grid", "Workflow");
        });
    </script>
}
