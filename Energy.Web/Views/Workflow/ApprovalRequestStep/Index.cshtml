@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalRequestStep.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalRequestStep.Title"]</h2></div>
    </header>
    <div id="approval-request-step-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-request-step/approval-request-step.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalRequest.Title"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalStepDefinition.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalRequestStep.init("/workflow/approval-request-steps", "approval-request-step-grid", "Workflow");
        });
    </script>
}
