@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalStepApprover.Title"].Value;
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalStepApprover.Title"]</h2></div>
    </header>
    <div id="approval-step-approver-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-step-approver/approval-step-approver.index.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalStepApprover.init("/workflow/approval-step-approvers", "approval-step-approver-grid", "Workflow");
        });
    </script>
}
