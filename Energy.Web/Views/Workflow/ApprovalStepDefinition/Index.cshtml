@using Energy.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<SharedResource> T
@{
    ViewData["Title"] = T["Workflow.ApprovalStepDefinition.Title"].Value;
    ViewData["ScreenId"] = "Workflow.ApprovalStepDefinition";
}

<section class="energy-screen">
    <header class="energy-screen__header">
        <div><h2>@T["Workflow.ApprovalStepDefinition.Title"]</h2></div>
    </header>
    <div id="approval-step-definition-grid"></div>
</section>

@section Scripts {
    <script src="~/js/workflow/approval-step-definition/approval-step-definition.index.js" asp-append-version="true"></script>
    <script>
        window.AppPageHelp = {
            intro: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Format(T["Help.IntroEntity"].Value, ViewData["Title"]))),
            related: [
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T["Workflow.ApprovalDefinitionVersion.Title"].Value))
            ]
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.AppPages.WorkflowApprovalStepDefinition.init("/workflow/approval-step-definitions", "approval-step-definition-grid", "Workflow");
        });
    </script>
}
